const express = require('express');
const cors = require('cors');
const multer = require('multer');
const { readStore, writeStore, makeId } = require('./store');
const {
  findCustomerByMeterNumber,
  readMeterFromImage,
  getActiveTariff,
  buildBillingSummary,
  createAlert,
  validateReading,
  createAuditLog
} = require('./services');

const upload = multer({ storage: multer.memoryStorage() });
const router = express.Router();

function respondSuccess(res, data, message = 'Operation successful') {
  return res.json({ success: true, data, message });
}

function respondError(res, status, message, code = 'ERROR') {
  return res.status(status).json({ success: false, error: message, code });
}

router.get('/health', (req, res) => {
  respondSuccess(res, { status: 'ok', service: 'AOT meter backend' });
});

router.post('/customers', (req, res) => {
  const store = readStore();
  const payload = req.body;

  if (!payload.customer_number || !payload.customer_name) {
    return respondError(res, 400, 'customer_number and customer_name are required', 'MISSING_FIELDS');
  }

  const exists = store.customers.some((item) => item.customer_number === payload.customer_number || item.account_number === payload.account_number);
  if (exists) {
    return respondError(res, 409, 'Customer with the same number or account already exists', 'DUPLICATE_CUSTOMER');
  }

  const customer = {
    id: makeId('cust'),
    customer_number: payload.customer_number,
    account_number: payload.account_number || null,
    customer_name: payload.customer_name,
    address: payload.address || null,
    plot_no: payload.plot_no || null,
    service_area: payload.service_area || null,
    service_type: payload.service_type || 'Domestic',
    index_number: payload.index_number || null,
    status: payload.status || 'active',
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  };

  store.customers.push(customer);
  writeStore(store);

  createAuditLog({
    entityType: 'customer',
    entityId: customer.id,
    action: 'create',
    newValues: customer,
    actorName: 'system'
  });

  respondSuccess(res, customer, 'Customer created successfully');
});

router.get('/customers/:customerId', (req, res) => {
  const store = readStore();
  const customer = store.customers.find((item) => item.id === req.params.customerId);
  if (!customer) return respondError(res, 404, 'Customer not found', 'CUSTOMER_NOT_FOUND');
  respondSuccess(res, customer);
});

router.get('/customers/search', (req, res) => {
  const store = readStore();
  const query = (req.query.q || '').toLowerCase();
  const results = store.customers.filter((customer) => {
    const haystack = [
      customer.customer_name,
      customer.customer_number,
      customer.account_number,
      customer.service_area,
      customer.service_type,
      customer.index_number
    ].join(' ').toLowerCase();

    return !query || haystack.includes(query);
  });

  respondSuccess(res, results.slice(0, 20));
});

router.get('/customers/by-meter/:meterNumber', (req, res) => {
  const store = readStore();
  const meter = store.meters.find((item) => item.meter_number === req.params.meterNumber);
  if (!meter) return respondError(res, 404, 'Meter not found', 'METER_NOT_FOUND');

  const customer = store.customers.find((item) => item.id === meter.customer_id);
  if (!customer) return respondError(res, 404, 'Customer not found for meter', 'CUSTOMER_NOT_FOUND');

  respondSuccess(res, { customer, meter });
});

router.post('/meters', (req, res) => {
