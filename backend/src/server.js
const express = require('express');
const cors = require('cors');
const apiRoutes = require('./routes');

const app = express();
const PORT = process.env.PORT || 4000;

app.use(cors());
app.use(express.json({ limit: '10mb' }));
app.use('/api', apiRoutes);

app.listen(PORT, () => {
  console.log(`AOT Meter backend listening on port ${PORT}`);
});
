router.post('/readings/ocr', upload.single('image'), async (req, res) => {
  try {
    if (!req.file) {
      return respondError(res, 400, 'Image file is required', 'MISSING_IMAGE');
    }

    const result = await readMeterFromImage(req.file.buffer);
    respondSuccess(res, result, 'OCR reading processed');
  } catch (err) {
    return respondError(res, 500, err.message || 'OCR processing failed', 'OCR_FAILED');
  }
});

router.post('/readings', (req, res) => {
  const store = readStore();
  const payload = req.body;

  if (!payload.meter_id || !payload.customer_id || !payload.current_reading) {
    return respondError(res, 400, 'meter_id, customer_id and current_reading are required', 'MISSING_FIELDS');
  }

  const meter = store.meters.find((item) => item.id === payload.meter_id);
  const customer = store.customers.find((item) => item.id === payload.customer_id);

  if (!meter || !customer) {
    return respondError(res, 404, 'Meter or customer not found', 'INVALID_METER_CUSTOMER');
  }

  const previousReading = meter.current_reading ?? meter.previous_reading ?? 0;
  const validation = validateReading({
    meter,
    customer,
    readingValue: payload.current_reading,
    previousReading,
    meterNumber: meter.meter_number
  });

  if (!validation.ok) {
    const alert = createAlert({
      meterId: meter.id,
      customerId: customer.id,
      alertType: validation.anomaly || 'reading_validation',
      severity: validation.status === 'anomaly' ? 'high' : 'medium',
      message: validation.issue
    });

    return respondError(res, 400, validation.issue, validation.status === 'anomaly' ? 'READING_ANOMALY' : 'READING_VALIDATION');
  }

  const reading = {
    id: makeId('read'),
    meter_id: meter.id,
    customer_id: customer.id,
    officer_id: payload.officer_id || null,
    reading_date: payload.reading_date || new Date().toISOString(),
    previous_reading: previousReading,
    current_reading: Number(payload.current_reading),
    consumption: Number(payload.current_reading) - Number(previousReading),
    gps_latitude: payload.gps_latitude || null,
    gps_longitude: payload.gps_longitude || null,
    photo_path: payload.photo_path || null,
    ocr_confidence: payload.ocr_confidence || 1,
    validation_status: 'validated',
    anomaly_status: 'normal',
    anomaly_reason: null,
    source: 'mobile_app',
    notes: payload.notes || null,
    created_at: new Date().toISOString()
  };

  store.meter_readings.unshift(reading);
  meter.previous_reading = meter.current_reading;
  meter.current_reading = Number(payload.current_reading);
  meter.updated_at = new Date().toISOString();

  writeStore(store);

  createAuditLog({
    entityType: 'meter_reading',
    entityId: reading.id,
    action: 'create',
    newValues: reading,
    actorName: 'field_officer'
  });

  respondSuccess(res, reading, 'Reading submitted successfully');
});

