router.post('/bills/calculate', (req, res) => {
  const payload = req.body;

  if (!payload.customer_id || !payload.meter_id || !payload.current_reading || !payload.previous_reading || !payload.service_type) {
    return respondError(res, 400, 'customer_id, meter_id, current_reading, previous_reading and service_type are required', 'MISSING_FIELDS');
  }

  const billing = buildBillingSummary({
    customerId: payload.customer_id,
    meterId: payload.meter_id,
    billingPeriod: payload.billing_period || new Date().toISOString().slice(0, 7),
    previousReading: payload.previous_reading,
    currentReading: payload.current_reading,
    serviceType: payload.service_type
  });

  if (!billing.ok) {
    return respondError(res, 400, billing.error, 'BILLING_ERROR');
  }

  const result = {
    customer_id: payload.customer_id,
    meter_id: payload.meter_id,
    billing_period: payload.billing_period || new Date().toISOString().slice(0, 7),
    previous_reading: Number(payload.previous_reading),
    current_reading: Number(payload.current_reading),
    consumption: billing.consumption,
    rate_per_unit: billing.ratePerUnit,
    fixed_charge: billing.fixedCharge,
    base_amount: billing.baseAmount,
    water_expansion: billing.waterExpansion,
    fire_fighting: billing.fireFighting,
    previous_balance: billing.previousBalance,
    amount_due: billing.amountDue,
    total_due: billing.totalDue,
    status: 'calculated'
  };

  respondSuccess(res, result, 'Bill calculated successfully');
});

router.post('/bills/generate-period', (req, res) => {
  const store = readStore();
  const payload = req.body;
  const billingPeriod = payload.billing_period || new Date().toISOString().slice(0, 7);

  const metersToProcess = store.meters.filter((meter) => {
    if (payload.service_area && meter.service_area !== payload.service_area) return false;
    if (payload.service_type) {
      const customer = store.customers.find((item) => item.id === meter.customer_id);
      if (!customer || customer.service_type !== payload.service_type) return false;
    }
    return true;
  });

  const generated = [];

  for (const meter of metersToProcess) {
    const customer = store.customers.find((item) => item.id === meter.customer_id);
    const previousReading = meter.current_reading ?? meter.previous_reading ?? 0;
    const currentReading = meter.current_reading ?? 0;
    const serviceType = customer?.service_type || 'Domestic';

    const billing = buildBillingSummary({
      customerId: customer.id,
      meterId: meter.id,
      billingPeriod,
      previousReading,
      currentReading,
      serviceType
    });

    if (!billing.ok) continue;

    const bill = {
      id: makeId('bill'),
      customer_id: customer.id,
      meter_id: meter.id,
      tariff_id: billing.tariff.id,
      billing_period: billingPeriod,
      previous_reading: previousReading,
      current_reading: currentReading,
      consumption: billing.consumption,
      rate_per_unit: billing.ratePerUnit,
      fixed_charge: billing.fixedCharge,
      base_amount: billing.baseAmount,
      water_expansion: billing.waterExpansion,
      fire_fighting: billing.fireFighting,
      previous_balance: billing.previousBalance,
      amount_due: billing.amountDue,
      total_due: billing.totalDue,
      status: 'pending',
      issued_at: new Date().toISOString(),
      due_date: new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10),
      paid_at: null,
      paid_amount: 0,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    };

    store.bills.push(bill);
    generated.push(bill);
  }

  writeStore(store);

  respondSuccess(res, {
    billing_period: billingPeriod,
    bills_generated: generated.length,
    total_amount: generated.reduce((sum, bill) => sum + Number(bill.amount_due || 0), 0)
  }, 'Bills generated successfully');
});

