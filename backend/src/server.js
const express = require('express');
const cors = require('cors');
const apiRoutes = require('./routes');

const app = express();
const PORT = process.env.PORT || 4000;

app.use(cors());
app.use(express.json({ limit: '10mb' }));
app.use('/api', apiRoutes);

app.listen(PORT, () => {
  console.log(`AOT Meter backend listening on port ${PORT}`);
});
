router.post('/alerts/resolve/:alertId', (req, res) => {
  const store = readStore();
  const alert = store.alerts.find((item) => item.id === req.params.alertId);
  if (!alert) return respondError(res, 404, 'Alert not found', 'ALERT_NOT_FOUND');

  alert.status = 'resolved';
  alert.resolved_at = new Date().toISOString();
  alert.resolved_by = req.body.resolved_by || null;
  writeStore(store);

  respondSuccess(res, alert, 'Alert resolved');
});

router.get('/reports/daily', (req, res) => {
  const store = readStore();
  const totalMeters = store.meters.length;
  const totalReadings = store.meter_readings.length;
  const unreadableAlerts = store.alerts.filter((item) => item.alert_type === 'meter_unreadable' && item.status === 'open').length;

  respondSuccess(res, {
    date: req.query.date || new Date().toISOString().slice(0, 10),
    service_area: req.query.service_area || 'all',
    total_meters: totalMeters,
    total_readings: totalReadings,
    total_unreadable: unreadableAlerts,
    total_anomalies: store.alerts.filter((item) => item.status === 'open').length
  });
});

router.post('/routes', (req, res) => {
  const store = readStore();
  const payload = req.body;

  if (!payload.route_name || !payload.assigned_officer_id) {
    return respondError(res, 400, 'route_name and assigned_officer_id are required', 'MISSING_FIELDS');
  }

  const route = {
    id: makeId('route'),
    route_name: payload.route_name,
    assigned_officer_id: payload.assigned_officer_id,
    service_area: payload.service_area || null,
    scheduled_date: payload.scheduled_date || new Date().toISOString().slice(0, 10),
    status: 'pending',
    total_meters: payload.meter_ids ? payload.meter_ids.length : 0,
    meters_read: 0,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  };

  store.routes.push(route);

  if (payload.meter_ids && Array.isArray(payload.meter_ids)) {
    for (const meterId of payload.meter_ids) {
      store.route_meters = store.route_meters || [];
      store.route_meters.push({
        id: makeId('route-meter'),
        route_id: route.id,
        meter_id: meterId,
        status: 'pending',
        read_at: null,
        created_at: new Date().toISOString()
      });
    }
  }

  writeStore(store);
  respondSuccess(res, route, 'Route created successfully');
});

router.get('/routes/:routeId', (req, res) => {
  const store = readStore();
  const route = store.routes.find((item) => item.id === req.params.routeId);
  if (!route) return respondError(res, 404, 'Route not found', 'ROUTE_NOT_FOUND');

  const meters = (store.route_meters || [])
    .filter((item) => item.route_id === route.id)
    .map((item) => ({
      meter_id: item.meter_id,
      status: item.status,
      read_at: item.read_at
    }));

  respondSuccess(res, { ...route, meters });
});

module.exports = router;

